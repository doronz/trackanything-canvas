# Environment Configuration for Canvas MCP Client
# Copy this file to .env and customize as needed for your environment

# Application Environment (development, staging, production)
NODE_ENV=development

# Port Configuration
FRONTEND_PORT=3031
BACKEND_PORT=8081
BACKEND_INTERNAL_PORT=8000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8081

# Database Configuration
DATABASE_URL=sqlite:///./data/canvas_mcp.db

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3031,http://127.0.0.1:3031

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# Optional PostgreSQL Configuration (uncomment for production)
# POSTGRES_DB=canvas_mcp
# POSTGRES_USER=canvas_user
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_PORT=5432

# Security (add these for production)
# JWT_SECRET=your_jwt_secret_here
# ENCRYPTION_KEY=your_encryption_key_here
