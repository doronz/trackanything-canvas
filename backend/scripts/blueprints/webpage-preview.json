{
    "name": "Webpage Preview",
    "description": "Embed and preview web pages in an iframe",
    "widget_version": "2.0",
    "data_source": {
        "type": "userInput"
    },
    "data_schema": {
        "fields": [
            {
                "id": "url",
                "name": "Website URL",
                "type": "url",
                "required": false,
                "placeholder": "https://example.com",
                "description": "URL of the website to embed"
            },
            {
                "id": "title",
                "name": "Title",
                "type": "text",
                "required": false,
                "placeholder": "Page title...",
                "description": "Optional title for the webpage"
            }
        ]
    },
    "view_schema": {
        "displayComponent": "Iframe",
        "mappings": {
            "iframeUrl": "data.url",
            "iframeTitle": "data.title"
        }
    },
    "settings": {
        "title": "Webpage",
        "backgroundColor": "#ffffff",
        "textColor": "#374151",
        "fontSize": 14,
        "defaultWidth": 550,
        "defaultHeight": 400
    },
    "widget_metadata": {
        "category": "Web",
        "tags": [
            "webpage",
            "iframe",
            "embed",
            "web"
        ],
        "author": "Canvas MCP Client",
        "version": "2.0",
        "icon": "🌐"
    },
    "is_public": true
}
