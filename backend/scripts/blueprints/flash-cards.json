{
    "name": "Flash Cards",
    "description": "Study cards with question and answer sides",
    "widget_version": "2.0",
    "data_source": {
        "type": "userInput"
    },
    "data_schema": {
        "fields": [
            {
                "id": "front",
                "name": "Question/Front",
                "type": "textarea",
                "required": false,
                "placeholder": "Enter the question...",
                "description": "The question or front side of the card"
            },
            {
                "id": "back",
                "name": "Answer/Back",
                "type": "textarea",
                "required": false,
                "placeholder": "Enter the answer...",
                "description": "The answer or back side of the card"
            }
        ]
    },
    "view_schema": {
        "displayComponent": "Cards",
        "mappings": {
            "cardTitle": "data.front",
            "cardContent": "data.back"
        },
        "interactions": {
            "allowAdd": true,
            "allowEdit": true,
            "allowDelete": true
        }
    },
    "settings": {
        "title": "Flash Cards",
        "backgroundColor": "#ffffff",
        "textColor": "#374151",
        "fontSize": 14,
        "defaultWidth": 320,
        "defaultHeight": 400
    },
    "widget_metadata": {
        "category": "Education",
        "tags": [
            "flashcards",
            "study",
            "quiz",
            "education"
        ],
        "author": "Canvas MCP Client",
        "version": "2.0",
        "icon": "🎴"
    },
    "is_public": true
}
