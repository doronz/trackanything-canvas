{
    "name": "Video Player",
    "description": "Embed and play videos from YouTube, Vimeo, or direct URLs",
    "widget_version": "2.0",
    "data_source": {
        "type": "userInput"
    },
    "data_schema": {
        "fields": [
            {
                "id": "url",
                "name": "Video URL",
                "type": "url",
                "required": false,
                "placeholder": "https://youtube.com/watch?v=...",
                "description": "URL of the video to play"
            },
            {
                "id": "title",
                "name": "Title",
                "type": "text",
                "required": false,
                "placeholder": "Video title...",
                "description": "Optional title for the video"
            },
            {
                "id": "autoplay",
                "name": "Autoplay",
                "type": "boolean",
                "defaultValue": false,
                "description": "Start playing automatically"
            }
        ]
    },
    "view_schema": {
        "displayComponent": "Video",
        "mappings": {
            "videoUrl": "data.url",
            "videoTitle": "data.title",
            "videoAutoplay": "data.autoplay"
        }
    },
    "settings": {
        "title": "Video Player",
        "backgroundColor": "#000000",
        "textColor": "#ffffff",
        "fontSize": 14,
        "defaultWidth": 500,
        "defaultHeight": 420
    },
    "widget_metadata": {
        "category": "Media",
        "tags": [
            "video",
            "player",
            "youtube",
            "vimeo"
        ],
        "author": "Canvas MCP Client",
        "version": "2.0",
        "icon": "🎥"
    },
    "is_public": true
}
