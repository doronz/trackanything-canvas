{
    "name": "Markdown Editor",
    "description": "Rich text editor with markdown support and preview",
    "widget_version": "2.0",
    "data_source": {
        "type": "userInput"
    },
    "data_schema": {
        "fields": [
            {
                "id": "content",
                "name": "Markdown Content",
                "type": "richtext",
                "required": false,
                "placeholder": "# Start writing markdown...",
                "description": "Rich text content with markdown support"
            }
        ]
    },
    "view_schema": {
        "displayComponent": "Markdown",
        "mappings": {
            "markdownContent": "data.content"
        },
        "interactions": {
            "allowEdit": true
        }
    },
    "settings": {
        "title": "Markdown Editor",
        "backgroundColor": "#ffffff",
        "textColor": "#374151",
        "fontSize": 14,
        "defaultWidth": 650,
        "defaultHeight": 500
    },
    "widget_metadata": {
        "category": "Text",
        "tags": [
            "markdown",
            "editor",
            "text",
            "writing"
        ],
        "author": "Canvas MCP Client",
        "version": "2.0",
        "icon": "📝"
    },
    "is_public": true
}
