[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    venv,
    env,
    .venv,
    alembic/versions,
    migrations
# Ignore codes:
# E203: whitespace before ':'
# E501: line too long (handled by black)
# W503: line break before binary operator
# E402: module level import not at top of file
ignore = E203,E501,W503,E402
per-file-ignores =
    __init__.py:F401

